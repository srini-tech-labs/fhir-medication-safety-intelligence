# Copy this directory's contents into .local/ (git-ignored) at the repo root and fill in real values.
# Used ONLY by the opt-in provider-evaluation harness (scripts/live_check.py, scripts/check_provider_availability.py);
# the API server does not read this file. Values already exported in your shell take precedence over this file.
# No persistent shell/Windows env vars are required -- this file is the primary, repeatable credential source.

# Anthropic direct API (also usable via the older, separate ./.env -- either works)
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# OpenAI (Responses API)
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Databricks Foundation Model API (both required; the global ~/.databrickscfg is never read by this project)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_ENDPOINT=

# Optional: override the model used by the harness's live tooling
# EXPLANATION_MODEL=
