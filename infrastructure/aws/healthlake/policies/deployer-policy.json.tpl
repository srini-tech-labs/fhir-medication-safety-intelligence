{"Version":"2012-10-17","Statement":[
 {"Sid":"Identity","Effect":"Allow","Action":["sts:GetCallerIdentity"],"Resource":"*"},
 {"Sid":"AssumeMedSafetyRoles","Effect":"Allow","Action":"sts:AssumeRole","Resource":["arn:aws:iam::${ACCT}:role/MedSafetyHealthLakeAppRole","arn:aws:iam::${ACCT}:role/MedSafetyHealthLakeVerifierRole"]},
 {"Sid":"KmsCreateTagged","Effect":"Allow","Action":["kms:CreateKey","kms:TagResource"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestTag/Project":"medsafety-intelligence"}}},
 {"Sid":"KmsManageProjectKey","Effect":"Allow","Action":["kms:PutKeyPolicy","kms:EnableKeyRotation","kms:DescribeKey","kms:GetKeyPolicy","kms:GetKeyRotationStatus","kms:ListResourceTags","kms:ScheduleKeyDeletion","kms:GenerateDataKey","kms:Decrypt"],"Resource":"arn:aws:kms:us-east-1:${ACCT}:key/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"medsafety-intelligence"}}},
 {"Sid":"KmsGrantForHealthLake","Effect":"Allow","Action":"kms:CreateGrant","Resource":"arn:aws:kms:us-east-1:${ACCT}:key/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"medsafety-intelligence"},"Bool":{"kms:GrantIsForAWSResource":"true"}}},
 {"Sid":"KmsAlias","Effect":"Allow","Action":["kms:CreateAlias","kms:DeleteAlias"],"Resource":["arn:aws:kms:us-east-1:${ACCT}:alias/medsafety-healthlake-cmk","arn:aws:kms:us-east-1:${ACCT}:key/*"]},
 {"Sid":"KmsListAliases","Effect":"Allow","Action":"kms:ListAliases","Resource":"*"},
 {"Sid":"S3Buckets","Effect":"Allow","Action":["s3:CreateBucket","s3:DeleteBucket","s3:PutBucketPublicAccessBlock","s3:PutBucketOwnershipControls","s3:PutBucketVersioning","s3:PutEncryptionConfiguration","s3:PutBucketPolicy","s3:PutLifecycleConfiguration","s3:PutBucketTagging","s3:GetBucketLocation","s3:GetBucketPolicy","s3:GetBucketVersioning","s3:GetEncryptionConfiguration","s3:GetBucketPublicAccessBlock","s3:GetBucketOwnershipControls","s3:GetBucketTagging","s3:GetLifecycleConfiguration","s3:ListBucket","s3:ListBucketVersions"],"Resource":["arn:aws:s3:::${IMPORT_BUCKET}","arn:aws:s3:::${RESULTS_BUCKET}"]},
 {"Sid":"S3Objects","Effect":"Allow","Action":["s3:PutObject","s3:GetObject","s3:GetObjectVersion","s3:DeleteObject","s3:DeleteObjectVersion"],"Resource":["arn:aws:s3:::${IMPORT_BUCKET}/*","arn:aws:s3:::${RESULTS_BUCKET}/*"]},
 {"Sid":"IamRolesByName","Effect":"Allow","Action":["iam:CreateRole","iam:DeleteRole","iam:TagRole","iam:PutRolePolicy","iam:DeleteRolePolicy","iam:UpdateAssumeRolePolicy","iam:ListRolePolicies"],"Resource":"arn:aws:iam::${ACCT}:role/MedSafetyHealthLake*"},
 {"Sid":"IamGetRole","Effect":"Allow","Action":"iam:GetRole","Resource":"arn:aws:iam::${ACCT}:role/*"},
 {"Sid":"PassImportRoleToHealthLake","Effect":"Allow","Action":"iam:PassRole","Resource":"arn:aws:iam::${ACCT}:role/MedSafetyHealthLakeImportRole","Condition":{"StringEquals":{"iam:PassedToService":"healthlake.amazonaws.com"}}},
 {"Sid":"HealthLakeCreateTagged","Effect":"Allow","Action":["healthlake:CreateFHIRDatastore","healthlake:TagResource"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestTag/Project":"medsafety-intelligence"}}},
 {"Sid":"RamReadForHealthLakeCreate","Effect":"Allow","Action":"ram:GetResourceShareInvitations","Resource":"*"},
 {"Sid":"HealthLakeList","Effect":"Allow","Action":"healthlake:ListFHIRDatastores","Resource":"*"},
 {"Sid":"HealthLakeManageTaggedDatastore","Effect":"Allow","Action":["healthlake:DescribeFHIRDatastore","healthlake:DeleteFHIRDatastore","healthlake:TagResource","healthlake:ListTagsForResource"],"Resource":"arn:aws:healthlake:us-east-1:${ACCT}:datastore/fhir/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"medsafety-intelligence"}}},
 {"Sid":"HealthLakeImportJobs","Effect":"Allow","Action":["healthlake:StartFHIRImportJob","healthlake:DescribeFHIRImportJob","healthlake:ListFHIRImportJobs"],"Resource":"arn:aws:healthlake:us-east-1:${ACCT}:datastore/fhir/*","Condition":{"StringEquals":{"aws:ResourceTag/Project":"medsafety-intelligence"}}},
 {"Sid":"CloudTrailReadOnly","Effect":"Allow","Action":["cloudtrail:LookupEvents","cloudtrail:DescribeTrails"],"Resource":"*"}]}
